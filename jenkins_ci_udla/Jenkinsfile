pipeline {
    agent any

    options {
        // Descarga explicita en la primera etapa para hacer visible la integracion.
        skipDefaultCheckout(true)
        timestamps()
    }

    tools {
        // Crear en Jenkins > Administrar Jenkins > Herramientas > Maven.
        maven 'Maven3'
    }

    environment {
        // REEMPLAZAR con la URL HTTPS real del repositorio privado.
        GIT_URL = 'https://github.com/ElPaul593/Automatizacion_JENKINS'
    }

    stages {
        stage('1 - Integracion repositorio privado') {
            steps {
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
                    git branch: 'main',
                        credentialsId: 'github-private',
                        url: env.GIT_URL

                    script {
                        if (isUnix()) {
                            sh 'git rev-parse --short HEAD'
                        } else {
                            bat 'git rev-parse --short HEAD'
                        }
                    }
                }
            }
        }

        stage('2 - Compilacion y tests') {
            when {
                expression { currentBuild.currentResult == 'SUCCESS' }
            }
            steps {
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE', catchInterruptions: false) {
                    script {
                        if (isUnix()) {
                            sh 'mvn -B -ntp clean verify'
                        } else {
                            bat 'mvn -B -ntp clean verify'
                        }
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'target/surefire-reports/*.xml'
                    archiveArtifacts allowEmptyArchive: true, artifacts: 'target/*.jar'
                }
            }
        }

        stage('3 - Notificacion Telegram') {
            steps {
                script {
                    def estado = currentBuild.currentResult == 'SUCCESS' ? 'EXITOSA' : 'FALLIDA'
                    def mensaje = "Jenkins UDLA: ${estado} | Job: ${env.JOB_NAME} | Build #${env.BUILD_NUMBER} | ${env.BUILD_URL}"

                    withEnv(["TELEGRAM_MESSAGE=${mensaje}"]) {
                        withCredentials([
                            string(credentialsId: 'telegram-bot-token', variable: 'BOT_TOKEN'),
                            string(credentialsId: 'telegram-chat-id', variable: 'CHAT_ID')
                        ]) {
                            if (isUnix()) {
                                sh '''#!/bin/sh
set +x
curl --fail --silent --show-error --retry 2 \
  --request POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
  --data-urlencode "chat_id=${CHAT_ID}" \
  --data-urlencode "text=${TELEGRAM_MESSAGE}" > /dev/null
'''
                            } else {
                                powershell '''
$ErrorActionPreference = 'Stop'
$uri = 'https://api.telegram.org/bot' + $env:BOT_TOKEN + '/sendMessage'
$body = @{ chat_id = $env:CHAT_ID; text = $env:TELEGRAM_MESSAGE }
Invoke-RestMethod -Method Post -Uri $uri -Body $body -ErrorAction Stop | Out-Null
Write-Host 'Notificacion enviada a Telegram.'
'''
                            }
                        }
                    }
                }
            }
        }
    }
}
