pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timestamps()
    }

    // La segunda tarea se ejecuta en su propia rama sin modificar main.
    parameters {
        string(
            name: 'BRANCH_A_CONSTRUIR',
            defaultValue: 'feature/pipeline-optimizacion',
            description: 'Rama del proyecto que se compilara en Jenkins'
        )
    }

    tools {
        maven 'Maven3'
    }

    environment {
        GIT_URL = 'https://github.com/ElPaul593/Automatizacion_JENKINS.git'
    }

    stages {
        stage('1 - Integracion repositorio privado') {
            steps {
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                    // Evita reutilizar archivos viejos en el workspace del job.
                    deleteDir()
                    git branch: params.BRANCH_A_CONSTRUIR,
                        credentialsId: 'github-private',
                        url: env.GIT_URL
                    bat 'git rev-parse --short HEAD'
                    stash name: 'codigo-helpdesk', includes: 'jenkins_ci_udla/**'
                }
            }
        }

        stage('2 - Validaciones en paralelo') {
            when {
                expression { currentBuild.currentResult == 'SUCCESS' }
            }
            parallel {
                stage('2A - Compilacion y pruebas JUnit') {
                    steps {
                        dir('ci-build') {
                            unstash 'codigo-helpdesk'
                            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                bat 'mvn -B -ntp -f jenkins_ci_udla/pom.xml clean verify'
                            }
                        }
                    }
                    post {
                        always {
                            junit allowEmptyResults: true,
                                testResults: 'ci-build/jenkins_ci_udla/target/surefire-reports/*.xml'
                            archiveArtifacts allowEmptyArchive: true,
                                artifacts: 'ci-build/jenkins_ci_udla/target/*.jar'
                        }
                    }
                }

                stage('2B - Checkstyle y PMD') {
                    steps {
                        dir('ci-quality') {
                            unstash 'codigo-helpdesk'
                            catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                                // El otro bloque ya ejecuta JUnit; aqui solo generamos calidad.
                                bat 'mvn -B -ntp -Pcalidad -DskipTests -f jenkins_ci_udla/pom.xml clean verify'
                            }
                        }
                    }
                    post {
                        always {
                            archiveArtifacts allowEmptyArchive: true,
                                artifacts: 'ci-quality/jenkins_ci_udla/target/reports/*.html,ci-quality/jenkins_ci_udla/target/checkstyle-result.xml,ci-quality/jenkins_ci_udla/target/pmd.xml'
                        }
                    }
                }
            }
        }

        stage('3 - Notificacion Telegram') {
            steps {
                script {
                    def estado = currentBuild.currentResult == 'SUCCESS' ? 'EXITOSA' : 'FALLIDA'
                    def mensaje = "Jenkins UDLA: ${estado} | Job: ${env.JOB_NAME} | Build #${env.BUILD_NUMBER} | ${env.BUILD_URL}"
                    withEnv(["TELEGRAM_MESSAGE=${mensaje}"]) {
                        withCredentials([
                            string(credentialsId: 'telegram-bot-token', variable: 'BOT_TOKEN'),
                            string(credentialsId: 'telegram-chat-id', variable: 'CHAT_ID')
                        ]) {
                            powershell '''
$ErrorActionPreference = 'Stop'
$uri = 'https://api.telegram.org/bot' + $env:BOT_TOKEN + '/sendMessage'
$body = @{
    chat_id = $env:CHAT_ID
    text = $env:TELEGRAM_MESSAGE
}
Invoke-RestMethod -Method Post -Uri $uri -Body $body -ErrorAction Stop | Out-Null
Write-Host 'Notificacion enviada a Telegram.'
'''
                        }
                    }
                }
            }
        }
    }
}
